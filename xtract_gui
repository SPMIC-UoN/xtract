def set_supported_cursor(widget, *candidates):
    """Use the first cursor name supported by the current Tk platform."""
    for cursor in (*candidates, "arrow"):
        try:
            widget.configure(cursor=cursor)
            return cursor
        except tk.TclError:
            continue
    return None


def open_with_default_app(path: Path) -> None:
    """Open a file/folder with the desktop's registered default application."""
    path = path.expanduser().resolve()
    if platform.system() == "Darwin":
        command = ["open", str(path)]
    elif platform.system() == "Windows":
        os.startfile(str(path))
        return
    elif "microsoft" in platform.release().lower() and shutil.which("wslview"):
        command = ["wslview", str(path)]
    elif shutil.which("xdg-open"):
        command = ["xdg-open", str(path)]
    else:
        raise OSError("No desktop file opener was found (expected xdg-open or wslview).")
    subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class FieldRow:
    def __init__(self, parent, field: Field, row: int, changed):
        self.field = field
        details = [field.help, f"Command option: {field.flag}"]
        if field.required:
            details.append("Required input")
        if field.choices:
            details.append("Choices: " + ", ".join(choice for choice in field.choices if choice))
        if field.default:
            details.append("Default: " + field.default.replace("\n", ", "))
        if field.nargs > 1:
            details.append(f"Provide {field.nargs} values in the order shown")
        self.help_text = "\n".join(details)
        defaults = [item.strip() for item in field.default.replace(",", "\n").splitlines()]
        self.vars = ([tk.BooleanVar(value=False)] if field.kind == "bool" else
                     [tk.StringVar(value=defaults[index] if index < len(defaults) else "")
                      for index in range(field.nargs)])
        self.widgets = []
        if field.kind == "bool":
            self.widget = ttk.Checkbutton(parent, text=field.label, variable=self.vars[0], command=changed)
            self.widget.grid(row=row, column=0, columnspan=3, sticky="w", padx=8, pady=4)
            self.widgets.append(self.widget)
        else:
            label = field.label + ("  *" if field.required else "")
            label_box = ttk.Frame(parent)
            label_box.grid(row=row, column=0, sticky="nw", padx=(10, 12), pady=7)
            label_widget = ttk.Label(label_box, text=label)
            label_widget.pack(side="left")
            help_widget = ttk.Label(label_box, text="  [?]", style="Help.TLabel")
            set_supported_cursor(help_widget, "question_arrow", "help")
            help_widget.pack(side="left")
            ToolTip(label_widget, self.help_text)
            ToolTip(help_widget, self.help_text)
            if field.choices:
                self.widget = ttk.Combobox(parent, textvariable=self.vars[0], values=field.choices, state="readonly", width=25)
                self.widget.bind("<<ComboboxSelected>>", lambda _event: changed())
                self.widget.grid(row=row, column=1, sticky="ew", pady=5)
                self.widgets.append(self.widget)
            else:
                inputs = ttk.Frame(parent)
                inputs.grid(row=row, column=1, columnspan=2, sticky="ew", pady=3)
                inputs.columnconfigure(1, weight=1)
                for index, variable in enumerate(self.vars):
                    variable.trace_add("write", lambda *_: changed())
                    if field.nargs > 1:
                        sublabel = field.value_labels[index] if index < len(field.value_labels) else f"Value {index + 1}"
                        ttk.Label(inputs, text=sublabel, style="Subfield.TLabel", width=21).grid(
                            row=index, column=0, sticky="w", padx=(0, 8), pady=2)
                    entry = ttk.Entry(inputs, textvariable=variable)
                    entry.grid(row=index, column=1, sticky="ew", pady=2)
                    self.widgets.append(entry)
                    if field.kind in ("file", "folder"):
                        ttk.Button(inputs, text="Select...", command=lambda i=index: self._browse(i), width=9).grid(
                            row=index, column=2, padx=(6, 8), pady=2)
        for widget in self.widgets:
            widget.configure(takefocus=True)
            ToolTip(widget, self.help_text)

    def _browse(self, index=0):
        variable = self.vars[index]
        root = self.parent_root()
        initial = variable.get() or root.last_browse_dir
        initial_dir = initial if os.path.isdir(initial) else os.path.dirname(initial)
        if self.field.kind == "folder":
            result = filedialog.askdirectory(initialdir=initial_dir or None)
        else:
            result = filedialog.askopenfilename(initialdir=initial_dir or None)
        if not result:
            return
        variable.set(result)
        root.last_browse_dir = result if os.path.isdir(result) else os.path.dirname(result)

    def parent_root(self):
        return self.widgets[0].winfo_toplevel()

    def get(self):
        if self.field.kind == "bool":
            return self.vars[0].get()
        return "\n".join(variable.get().strip() for variable in self.vars if variable.get().strip())


class ToolTip:
    def __init__(self, widget, text):
        self.widget, self.text, self.popup = widget, text, None
        widget.bind("<Enter>", self.show, add=True)
        widget.bind("<Leave>", self.hide, add=True)

    def show(self, _event=None):
        if self.popup or not self.text:
            return
        x, y = self.widget.winfo_rootx() + 16, self.widget.winfo_rooty() + self.widget.winfo_height() + 4
        self.popup = tk.Toplevel(self.widget)
        self.popup.wm_overrideredirect(True)
        self.popup.wm_geometry(f"+{x}+{y}")
        ttk.Label(self.popup, text=self.text, wraplength=430, padding=8, style="Tooltip.TLabel").pack()

    def hide(self, _event=None):
        if self.popup:
            self.popup.destroy()
            self.popup = None


class ToolPanel(ttk.Frame):
    def __init__(self, parent, tool: Tool, app):
        super().__init__(parent, padding=(16, 12))
        self.tool, self.app, self.rows = tool, app, {}
        self.advanced_visible = tk.BooleanVar(value=False)
        self.columnconfigure(0, weight=1)

        header = ttk.Frame(self)
        header.grid(row=0, column=0, sticky="ew", pady=(0, 10))
        header.columnconfigure(0, weight=1)
        ttk.Label(header, text=tool.title, style="Title.TLabel").grid(row=0, column=0, sticky="w")
        ttk.Button(header, text="Open guide", command=lambda: webbrowser.open(DOCS_URL)).grid(row=0, column=1, sticky="e")
        ttk.Label(header, text=tool.summary, style="Summary.TLabel").grid(row=1, column=0, columnspan=2, sticky="w", pady=(2, 0))

        required = ttk.LabelFrame(self, text="Required inputs", padding=(4, 6))
        required.grid(row=1, column=0, sticky="ew")
        required.columnconfigure(1, weight=1)
        for index, field in enumerate(tool.required):
            self.rows[field.flag] = FieldRow(required, field, index, self._changed)

        self.advanced_button = ttk.Checkbutton(self, text="Show advanced options", variable=self.advanced_visible,
                                               command=self._toggle_advanced, style="Disclosure.TCheckbutton")
        self.advanced_button.grid(row=2, column=0, sticky="w", pady=(10, 4))
        self.advanced = ttk.LabelFrame(self, text="Advanced options", padding=(4, 6))
        self.advanced.columnconfigure(1, weight=1)
        for index, field in enumerate(tool.advanced):
            self.rows[field.flag] = FieldRow(self.advanced, field, index, self._changed)

        preview = ttk.LabelFrame(self, text="Command preview", padding=(8, 6))
        preview.grid(row=4, column=0, sticky="ew", pady=(10, 0))
        preview.columnconfigure(0, weight=1)
        colours = app.palette
        self.preview = tk.Text(preview, height=3, wrap="word", borderwidth=0, background=colours["field"],
                               foreground=colours["text"], insertbackground=colours["text"],
                               selectbackground=colours["selection"], selectforeground=colours["text"],
                               font=("TkFixedFont", 11), padx=9, pady=7)
        self.preview.grid(row=0, column=0, sticky="ew")
        self.preview.configure(state="disabled")
        preview_actions = ttk.Frame(preview)
        preview_actions.grid(row=0, column=1, padx=(8, 0), sticky="n")
        ttk.Button(preview_actions, text="Copy", command=self._copy, width=12).pack(pady=(0, 5))
        ttk.Button(preview_actions, text="Clear command", command=self._clear_command, width=12).pack()

        actions = ttk.Frame(self)
        actions.grid(row=5, column=0, sticky="ew", pady=(10, 0))
        actions.columnconfigure(0, weight=1)
        self.status = ttk.Label(actions, text="Complete the required inputs", style="Muted.TLabel")
        self.status.grid(row=0, column=0, sticky="w")
        self.result_button = ttk.Button(actions, command=self._open_result)
        self.result_button.grid(row=0, column=1, sticky="e", padx=(8, 0))
        self.result_button.grid_remove()
        self.result_path = None
        self.run_button = ttk.Button(actions, text=f"Run {tool.command}", command=self.run, style="Accent.TButton")
        self.run_button.grid(row=0, column=2, sticky="e", padx=(8, 0))
        self._changed()

    def values(self):
        return {flag: row.get() for flag, row in self.rows.items()}

    def command(self):
        return build_command(self.tool, self.values())

    def _toggle_advanced(self):
        if self.advanced_visible.get():
            self.advanced.grid(row=3, column=0, sticky="ew")
            self.advanced_button.configure(text="Hide advanced options")
        else:
            self.advanced.grid_remove()
            self.advanced_button.configure(text="Show advanced options")

    def _changed(self):
        try:
            command = self.command()
            text = display_command(command)
            self.status.configure(text="Ready to run")
        except ValidationError as error:
            text = self.tool.command + "  -  " + str(error)
            self.status.configure(text=str(error))
        self.preview.configure(state="normal")
        self.preview.delete("1.0", "end")
        self.preview.insert("1.0", text)
        self.preview.configure(state="disabled")

    def _copy(self):
        self.clipboard_clear()
        self.clipboard_append(self.preview.get("1.0", "end-1c"))
        self.status.configure(text="Command copied")

    def _clear_command(self):
        self.preview.configure(state="normal")
        self.preview.delete("1.0", "end")
        self.preview.configure(state="disabled")
        self.status.configure(text="Command preview cleared; editing an input will rebuild it")

    def run(self):
        try:
            command = self.command()
        except ValidationError as error:
            messagebox.showerror("Check the inputs", str(error), parent=self)
            return
        executable = command[0]
        if os.path.sep not in executable and not shutil_which(executable):
            messagebox.showerror("XTRACT command not found",
                                 f"Could not find '{self.tool.command}'. Start the GUI from an FSL terminal, or set XTRACT_GUI_BIN to the XTRACT bin folder.", parent=self)
            return
        self.result_button.grid_remove()
        self.result_path = None
        self.app.start_process(command, self.tool.title, self)

    def _expected_result(self):
        values = self.values()
        command = self.tool.command
        if command == "xtract_stats":
            path = values.get("-out") or str(Path(str(values.get("-xtract", ""))) / "stats.csv")
            return "Open stats file", Path(str(path))
        if command == "xtract_qc":
            return "Open QC report", Path(str(values.get("-out", ""))) / "qc_report.html"
        if command == "xtract_blueprint":
            path = values.get("-out") or str(Path(str(values.get("-xtract", ""))) / "blueprint")
            return "Open results folder", Path(str(path))
        if command in ("xtract", "xtract_divergence"):
            return "Open results folder", Path(str(values.get("-out", "")))
        if command == "xtract_viewer":
            return "Open results folder", Path(str(values.get("-xtract", "")))
        return None, None

    def show_result_action(self):
        label, path = self._expected_result()
        if label and path and str(path) and path.expanduser().exists():
            self.result_path = path
            self.result_button.configure(text=label)
            self.result_button.grid()

    def _open_result(self):
        if not self.result_path or not self.result_path.expanduser().exists():
            messagebox.showerror("Result not found", "The expected result no longer exists.", parent=self)
            self.result_button.grid_remove()
            return
        try:
            open_with_default_app(self.result_path)
        except OSError as error:
            messagebox.showerror("Could not open result", str(error), parent=self)


def shutil_which(command):
    from shutil import which
    return which(command)


