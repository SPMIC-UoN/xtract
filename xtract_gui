    def _toggle_theme(self):
        self.theme_choice.set("Dark" if self.theme_choice.get() == "Light" else "Light")
        self.settings["theme"] = self.theme_choice.get()
        save_settings(self.settings)
        self._style()
        self._update_theme_button()
        for canvas in self.canvases:
            canvas.configure(background=self.palette["bg"])
        for panel in self.panels:
            panel.preview.configure(background=self.palette["field"], foreground=self.palette["text"],
                                    insertbackground=self.palette["text"], selectbackground=self.palette["selection"],
                                    selectforeground=self.palette["text"])
