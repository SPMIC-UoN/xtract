    def _enable_mousewheel(self, canvas, region):
        def scroll(event):
            if getattr(event, "num", None) == 4:
                units = -3
            elif getattr(event, "num", None) == 5:
                units = 3
            else:
                delta = event.delta
                units = -1 * (delta if abs(delta) < 120 else int(delta / 120))
            canvas.yview_scroll(units, "units")
            return "break"

        def bind(_event):
            canvas.bind_all("<MouseWheel>", scroll)
            canvas.bind_all("<Button-4>", scroll)
            canvas.bind_all("<Button-5>", scroll)

        def unbind(_event):
            canvas.unbind_all("<MouseWheel>")
            canvas.unbind_all("<Button-4>")
            canvas.unbind_all("<Button-5>")

        region.bind("<Enter>", bind, add=True)
        region.bind("<Leave>", unbind, add=True)

