                               insertbackground=self.palette["console_text"],
                               selectbackground=self.palette["console_selection"])

    def log(self, text):
        self.console.insert("end", text)
        self.console.see("end")

    def start_process(self, command, title, panel):
        if self.process and self.process.poll() is None:
            messagebox.showinfo("A tool is already running", "Stop the current run before starting another.", parent=self)
            return
        self.log(f"\n$ {display_command(command)}\n")
        self.process_error_seen = False
        try:
            self.process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                            text=True, bufsize=1, start_new_session=True)
        except OSError as error:
            self.log(f"Could not start: {error}\n")
            messagebox.showerror("Could not start", str(error), parent=self)
            return
        self.cancel_button.configure(state="normal")
        threading.Thread(target=self._read_process, args=(self.process, title, panel), daemon=True).start()

    def _read_process(self, process, title, panel):
        for line in iter(process.stdout.readline, ""):
            if "Traceback (most recent call last)" in line or line.lstrip().startswith("NameError:"):
                self.process_error_seen = True
            self.after(0, self.log, line)
        code = process.wait()
        self.after(0, self._process_finished, process, title, panel, code)

    def _process_finished(self, process, title, panel, code):
        if self.process is process:
            self.cancel_button.configure(state="disabled")
            failed = code != 0 or self.process_error_seen
            if failed:
                detail = f"exited with code {code}" if code != 0 else "reported a Python traceback"
                self.log(f"\n{title} failed: {detail}. Review the run log above.\n")
                messagebox.showerror(
                    f"{title} did not complete",
                    f"The command {detail}. Review the run log for details.",
                    parent=self,
                )
            else:
                self.log(f"\n{title} finished successfully.\n")
                panel.show_result_action()

    def stop_process(self):
        if self.process and self.process.poll() is None:
            try:
                os.killpg(self.process.pid, signal.SIGTERM)
                self.log("\nStopping process...\n")
            except ProcessLookupError:
                pass

    def _close(self):
        if self.process and self.process.poll() is None:
            if not messagebox.askyesno("A tool is running", "Stop it and close XTRACT?", parent=self):
                return
            self.stop_process()
        self.destroy()


