# --- Launcher and version reporting ---

def get_version_text():
    """Return installed FSL and XTRACT component versions on request."""
    fsldir = os.environ.get("FSLDIR")
    if not fsldir:
        return "Unable to determine versions: FSLDIR is not set"
    import glob
    import json
    wanted = {"fsl-xtract", "fsl-xtract_data", "fsl-ptx2"}
    lines = []
    try:
        with open(os.path.join(fsldir, "etc", "fslversion")) as version_file:
            lines.append(f"FSL: {version_file.read().strip()}")
        packages = {}
        for metadata_path in glob.glob(os.path.join(fsldir, "conda-meta", "*.json")):
            with open(metadata_path) as metadata_file:
                metadata = json.load(metadata_file)
            if metadata.get("name") in wanted:
                packages[metadata["name"]] = metadata.get("version", "unknown")
        if wanted.issubset(packages):
            lines.extend(f"{name}: {packages[name]}" for name in
                         ("fsl-ptx2", "fsl-xtract", "fsl-xtract_data"))
            return "Versions:\n" + "\n".join(lines)
    except (OSError, ValueError, TypeError):
        pass
    result = subprocess.run([os.path.join(fsldir, "bin", "fslversion"), "-p"],
                            capture_output=True, text=True)
    if result.returncode != 0:
        return f"Unable to determine versions: {result.stderr.strip()}"
    lines = []
    for line in result.stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("Version:"):
            lines.append(f'FSL: {stripped.split(":", 1)[1].strip()}')
            continue
        fields = stripped.split()
        if len(fields) >= 2 and fields[0] in wanted:
            lines.append(f"{fields[0]}: {fields[1]}")
    return "Versions:\n" + "\n".join(lines)


if __name__ == "__main__":
    if any(argument in ("-version", "--version") for argument in sys.argv[1:]):
        print(get_version_text())
    else:
        main()
