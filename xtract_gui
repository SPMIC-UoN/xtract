# --- Command construction and validation ---

"""Command construction and validation, kept independent from the GUI toolkit."""

import os
import shlex
import shutil
from pathlib import Path
from typing import Dict, List



class ValidationError(ValueError):
    pass


def split_values(value: str, count: int) -> List[str]:
    value = value.strip()
    if count == 1:
        return [value] if value else []
    # Multi-value path inputs are entered one per line. Commas remain valid in paths.
    values = [item.strip() for item in value.splitlines() if item.strip()]
    if len(values) == 1 and "," in values[0]:
        values = [item.strip() for item in values[0].split(",") if item.strip()]
    return values


def validate_field(field: Field, value: str) -> List[str]:
    if field.kind == "bool":
        return []
    values = split_values(value, field.nargs)
    if field.required and not values:
        raise ValidationError(f"{field.label} is required.")
    if values and len(values) != field.nargs:
        raise ValidationError(f"{field.label} needs {field.nargs} values (enter one per line).")
    if field.kind in ("int", "float") and values:
        converter = int if field.kind == "int" else float
        try:
            for item in values:
                converter(item)
        except ValueError as error:
            raise ValidationError(f"{field.label} must be a valid {field.kind}.") from error
    if field.choices and values and values[0] not in field.choices:
        raise ValidationError(f"Choose a valid value for {field.label}.")
    return values


def resolve_command(command: str) -> str:
    override = os.environ.get("XTRACT_GUI_BIN")
    if override:
        candidate = Path(override) / command
        if candidate.is_file():
            return str(candidate)
    fsldir = os.environ.get("FSLDIR")
    if fsldir:
        candidate = Path(fsldir) / "bin" / command
        if candidate.is_file():
            return str(candidate)
    return shutil.which(command) or command


def build_command(tool: Tool, values: Dict[str, object]) -> List[str]:
    command = [resolve_command(tool.command)]
    for field in tool.required + tool.advanced:
        raw = values.get(field.flag, False if field.kind == "bool" else "")
        if field.kind == "bool":
            if bool(raw):
                command.append(field.flag)
            continue
        parts = validate_field(field, str(raw))
        if parts:
            command.extend((field.flag, *parts))
    # Cross-field rules from the command interfaces.
    if tool.command == "xtract" and values.get("-species") == "CUSTOM":
        for flag, label in (("-str", "Structures file"), ("-p", "Protocols folder"), ("-stdref", "Standard reference")):
            if not str(values.get(flag, "")).strip():
                raise ValidationError(f"{label} is required when Species is CUSTOM.")
    if tool.command == "xtract_divergence" and str(values.get("-roi", "")).strip() and not str(values.get("-hemi", "")).strip():
        raise ValidationError("ROI hemisphere is required when an ROI is supplied.")
    return command


def display_command(command: List[str]) -> str:
    return shlex.join(command)

# --- Persistent GUI settings ---

"""Dependency-free user settings and operating-system theme detection."""

import json
import os
import platform
from pathlib import Path


def settings_path() -> Path:
    system = platform.system()
    if system == "Darwin":
        root = Path.home() / "Library" / "Application Support"
    elif system == "Windows":
        root = Path(os.environ.get("APPDATA", Path.home() / "AppData" / "Roaming"))
    else:
        root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return root / "xtract_gui" / "settings.json"


def load_settings() -> dict:
    try:
        data = json.loads(settings_path().read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def save_settings(settings: dict) -> None:
    try:
        path = settings_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    except OSError:
        pass

